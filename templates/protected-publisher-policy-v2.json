{
  "schema": "pr-review-protected-publication-policy.v2",
  "authorization_mode": "STANDING_BOUNDED",
  "enabled": false,
  "repository": {
    "name": "REPLACE_WITH_OWNER_AND_REPOSITORY",
    "id": 0
  },
  "default_branch": "REPLACE_WITH_PROTECTED_DEFAULT_BRANCH",
  "publisher_workflow": {
    "id": 0,
    "path": ".github/workflows/pr-publish.yml",
    "ref": "REPLACE_WITH_OWNER_AND_REPOSITORY/.github/workflows/pr-publish.yml@refs/heads/REPLACE_WITH_PROTECTED_DEFAULT_BRANCH",
    "sha256": "REPLACE_WITH_REVIEWED_PUBLISHER_WORKFLOW_SHA256"
  },
  "source_workflow": {
    "id": 0,
    "path": ".github/workflows/REPLACE_WITH_PROTECTED_ANALYSIS_WORKFLOW.yml",
    "ref": "REPLACE_WITH_OWNER_AND_REPOSITORY/.github/workflows/REPLACE_WITH_PROTECTED_ANALYSIS_WORKFLOW.yml@refs/heads/REPLACE_WITH_PROTECTED_DEFAULT_BRANCH"
  },
  "called_harness": {
    "repository": "REPLACE_WITH_OWNER_AND_HARNESS_REPOSITORY",
    "path": ".github/workflows/pr-analysis.yml",
    "sha": "REPLACE_WITH_VERIFIED_40_CHARACTER_HARNESS_COMMIT_SHA"
  },
  "credential": {
    "kind": "ACTIONS_TOKEN",
    "actor_login": "github-actions[bot]"
  },
  "profile": {
    "version": "REPLACE_WITH_REVIEW_PROFILE_VERSION",
    "sha256": "REPLACE_WITH_64_CHARACTER_PROFILE_SHA256",
