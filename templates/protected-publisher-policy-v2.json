    "max_pages": 2,
    "max_reviews": 100,
    "deadline_seconds": 25
  },
  "artifact_trust_mode": "API_BOUND_SHA256",
  "artifact_redirect_hosts": ["REPLACE_WITH_APPROVED_GITHUB_ARTIFACT_DOWNLOAD_HOST"]
