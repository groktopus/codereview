{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/groktopus/codereview/schemas/review-evidence-waiver.v1.schema.json",
  "title": "Review evidence waiver v1",
  "description": "A named reviewer's bounded, expiring exception for exact missing-evidence or execution-failure obligations. Missing evidence is denied by default. A waiver never changes a finding or an existing blocker.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "reviewer",
    "reason",
    "repository",
    "base_sha",
    "head_sha",
    "issued_at",
    "expires_at",
    "waivers"
  ],
  "properties": {
    "schema": {
      "const": "review-evidence-waiver.v1"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "reason": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "waivers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/target"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "justification"
      ],
      "properties": {
        "kind": {
          "enum": [
            "context_gap",
            "check",
            "coverage_note",
            "execution_failure"
          ]
        },
        "justification": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]{1,128}$"
        }
      },
      "oneOf": [
        {
          "required": [
            "id"
          ],
          "not": {
            "required": [
              "reason_code"
            ]
          }
        },
        {
          "required": [
            "reason_code"
          ],
          "not": {
            "required": [
              "id"
            ]
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "execution_failure"
              }
            },
            "required": [
              "reason_code"
            ]
          },
          "then": {
            "properties": {
              "reason_code": {
                "enum": [
                  "DEADLINE_EXHAUSTED",
                  "REQUIRED_OUTPUT_QUARANTINED",
                  "MISSING_RESULT",
                  "OUTPUT_BYTE_BUDGET_EXHAUSTED",
                  "CONTEXT_EVIDENCE_TRUNCATED",
                  "PROVIDER_UNAVAILABLE",
                  "CONTEXT_GAP_UNRESOLVED",
                  "CONTEXT_NOT_COVERED", "PARTIAL_REVIEW_COVERAGE", "COVERAGE_NOTE_MISSING", "UNIT_EVIDENCE_EXCEEDS_INPUT_LIMIT", "REQUIRED_CONTEXT_NOT_COVERED"
                ]
              }
            }
          }
        }
      ],
      "description": "Exactly one id or reason_code. An id is an exact planned obligation target. A reason_code is accepted only when exactly one required incomplete obligation matches; a multi-row reason-code match is rejected as overbroad. An execution_failure reason_code must be one exact allowlisted code and targets one or more required incomplete rows with that exact reason by its reported reason; there is no wildcard, prefix, or whole-family form."
    }
  }
}
