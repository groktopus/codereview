{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/groktopus/codereview/schemas/review-evidence-waiver.v1.schema.json",
  "title": "Review evidence waiver v1",
  "description": "A named reviewer's bounded, expiring exception for exact missing-evidence obligations. Missing evidence is denied by default. A waiver never changes a finding or an existing blocker.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "reviewer",
    "reason",
    "repository",
    "base_sha",
    "head_sha",
    "issued_at",
    "expires_at",
    "waivers"
  ],
  "properties": {
    "schema": { "const": "review-evidence-waiver.v1" },
    "reviewer": { "type": "string", "minLength": 1, "maxLength": 200 },
    "reason": { "type": "string", "minLength": 20, "maxLength": 2000 },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "waivers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/target" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "justification"],
      "properties": {
        "kind": { "enum": ["context_gap", "check", "coverage_note"] },
        "justification": { "type": "string", "minLength": 10, "maxLength": 2000 }
      },
      "oneOf": [
        {
          "required": ["id"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
            }
          }
        },
        {
          "required": ["reason_code"],
          "properties": {
            "reason_code": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_]{1,128}$"
            }
          }
        }
      ]
    }
  }
}
