{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/groktopus/codereview/schemas/contract-registry.v1.schema.json",
  "title": "Review harness contract registry",
  "description": "Machine-readable contract/version registry. Status is one of supported, deprecated, or archived; exactly one review contract, profile, and limits set may be supported.",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "owner", "supported_combination", "targets", "deprecation_policy", "contracts"],
  "properties": {
    "registry_version": {"const": "contract-registry.v1"},
    "owner": {"type": "string", "minLength": 1},
    "supported_combination": {"$ref": "#/$defs/supportedCombination"},
    "targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["default_review_contract", "review_contracts"],
        "properties": {
          "default_review_contract": {"type": "string", "minLength": 1},
          "review_contracts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "deprecation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["announcement", "replacement_path", "compatibility_window", "removal_evidence"],
      "properties": {
        "announcement": {"type": "string", "minLength": 1},
        "replacement_path": {"type": "string", "minLength": 1},
        "compatibility_window": {"type": "string", "minLength": 1},
        "removal_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/contract"}
    }
  },
  "$defs": {
    "supportedCombination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_contract", "profile", "limits", "target_repository"],
      "properties": {
        "review_contract": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1},
        "limits": {"type": "string", "minLength": 1},
        "target_repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}
      }
    },
    "compatibilityWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starts", "ends"],
      "properties": {
        "starts": {"type": "string", "format": "date"},
        "ends": {"type": "string", "format": "date"}
      }
    },
    "deprecation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["announced_on", "announcement_ref", "replacement_path", "compatibility_window", "removal_evidence"],
      "properties": {
        "announced_on": {"type": "string", "format": "date"},
        "announcement_ref": {"type": "string", "minLength": 1},
        "replacement_path": {"type": "string", "minLength": 1},
        "compatibility_window": {"$ref": "#/$defs/compatibilityWindow"},
        "removal_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "terminal": {"const": true},
        "terminal_reason": {"type": "string", "minLength": 1}
      }
    },
    "archived": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archived_on", "archival_note", "evidence_paths"],
      "properties": {
        "archived_on": {"type": "string", "format": "date"},
        "archival_note": {"type": "string", "minLength": 1},
        "evidence_paths": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "equals": true,
        "contains": true,
        "absent": {"const": true},
        "length_equals": {"type": "integer", "minimum": 0},
        "equals_exact": true
      },
      "oneOf": [
        {"required": ["equals"]},
        {"required": ["contains"]},
        {"required": ["absent"]},
        {"required": ["length_equals"]},
        {"required": ["equals_exact"]}
      ]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "version",
        "status",
        "owner",
        "replaced_by",
        "source_path",
        "source_sha256",
        "source_symbol",
        "invariants"
      ],
      "properties": {
        "kind": {
          "enum": [
            "review-contract",
            "review-profile",
            "review-profile-template",
            "review-limits",
            "claim-assessment",
            "canary-receipt",
            "model-output",
            "model-input",
            "context",
            "policy",
            "artifact",
            "registry"
          ]
        },
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"enum": ["supported", "deprecated", "archived"]},
        "owner": {"type": "string", "minLength": 1},
        "replaced_by": {"type": ["string", "null"], "minLength": 1},
        "source_path": {"type": ["string", "null"], "pattern": "^(?!/)(?!.*\\.\\.).+$"},
        "source_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "source_symbol": {"type": ["string", "null"], "minLength": 1},
        "invariants": {"type": "object"},
        "notes": {"type": "string"},
        "deprecation": {"$ref": "#/$defs/deprecation"},
        "archived": {"$ref": "#/$defs/archived"},
        "combination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_repository", "profile", "limits", "max_claim_assessments"],
          "properties": {
            "target_repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
            "profile": {"type": "string", "minLength": 1},
            "limits": {"type": "string", "minLength": 1},
            "max_claim_assessments": {"type": "integer", "minimum": 0, "maximum": 4}
          }
        },
        "mismatch_error": {"type": "string", "minLength": 1},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
        "repository": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "values": {"type": "object"},
        "applies_to": {"enum": ["default", "PR_MERGE_BASE", "legacy"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "supported"}}},
          "then": {
            "properties": {"replaced_by": {"type": "null"}},
            "not": {"anyOf": [{"required": ["deprecation"]}, {"required": ["archived"]}]}
          }
        },
        {
          "if": {"properties": {"status": {"const": "deprecated"}}},
          "then": {"required": ["deprecation"], "not": {"required": ["archived"]}}
        },
        {
          "if": {"properties": {"status": {"const": "archived"}}},
          "then": {"required": ["archived"], "not": {"required": ["deprecation"]}}
        },
        {
          "if": {"properties": {"kind": {"const": "review-contract"}}},
          "then": {"required": ["combination", "mismatch_error"]},
          "else": {"not": {"anyOf": [{"required": ["combination"]}, {"required": ["mismatch_error"]}]}}
        },
        {
          "if": {"properties": {"kind": {"const": "review-profile"}}},
          "then": {"required": ["repository"]}
        },
        {
          "if": {"properties": {"kind": {"const": "review-limits"}}},
          "then": {"required": ["values"]}
        },
        {
          "if": {"properties": {"kind": {"const": "claim-assessment"}}},
          "then": {"required": ["applies_to"]}
        }
      ]
    }
  }
}
